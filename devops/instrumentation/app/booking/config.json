{
  "app": {
    "name": "booking-app",
    "host": "localhost",
    "port": 8080,
    "env": "development",
    "metric": {
      "host": "localhost",
      "port": 7070
    }
  },
  "postgres": {
    "host": "localhost",
    "port": 5432,
    "user": "postgres",
    "password": "my-secret-pw",
    "dbname": "booking_db",
    "sslmode": "disable",
    "max_open_conns": 10,
    "max_idle_conns": 5,
    "conn_max_lifetime": "1h"
  },
  "logger": {
    "level": "info",
    "filepath": "logs/app.log"
  },
  "consul": {
    "address": "localhost:8500",
    "wait_time": "15m"
  }
}
