{
  "app": {
    "name": "course-app",
    "host": "course-app",
    "port": 8082,
    "env": "production",
    "metric": {
      "host": "course-app",
      "port": 7072
    }
  },
  "postgres": {
    "host": "postgres",
    "port": 5432,
    "user": "postgres",
    "password": "my-secret-pw",
    "dbname": "course_db",
    "sslmode": "disable",
    "max_open_conns": 10,
    "max_idle_conns": 5,
    "conn_max_lifetime": "1h"
  },
  "logger": {
    "level": "info",
    "filepath": "logs/app.log"
  },
  "consul": {
    "address": "consul:8500",
    "wait_time": "15m"
  },
  "otel": {
    "host": "jaeger",
    "port": "4317"
  }
}
