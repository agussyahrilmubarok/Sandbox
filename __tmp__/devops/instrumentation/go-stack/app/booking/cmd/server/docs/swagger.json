    "host": "localhost:8080",
    "paths": {
        "/api/v1/booking/course": {
            "post": {
                "description": "Book a seat for a course by providing booking details",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Booking"
                ],
                "summary": "Book a course seat",
                "parameters": [
                    {
                        "description": "Booking Request",
                        "name": "booking_request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/booking.BookingRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully booked the course",
                        "schema": {
                            "$ref": "#/definitions/booking.Booking"
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v2/booking/course": {
            "post": {
                "description": "Book a seat for a course using goroutines (parallel processing)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Booking"
                ],
                "summary": "Book a course seat (v2)",
                "parameters": [
                    {
                        "description": "Booking Request",
                        "name": "booking_request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/booking.BookingRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully booked the course",
                        "schema": {
                            "$ref": "#/definitions/booking.Booking"
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "booking.Booking": {
            "type": "object",
            "properties": {
                "booking_date": {
                    "type": "string"
                },
                "course_code": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "member_code": {
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/booking.BookingStatus"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "booking.BookingRequest": {
            "type": "object",
            "properties": {
                "course_code": {
                    "type": "string"
                },
                "member_code": {
                    "type": "string"
                }
            }
        },
        "booking.BookingStatus": {
            "type": "integer",
            "enum": [
                0,
                1,
                2
            ],
            "x-enum-varnames": [
                "BookingStatusPending",
                "BookingStatusConfirmed",
                "BookingStatusCancelled"
            ]
        }
    }
}